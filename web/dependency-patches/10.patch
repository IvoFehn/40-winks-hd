+                "<br />"
+                "Note: <recomp-color primary>4x</recomp-color> downsampling quality at <recomp-color primary>Original 2x</recomp-color> resolution may cause performance issues on low end devices, as it will cause the game to render <recomp-color warning>at almost 4k internal resolution</recomp-color>.",
+                downsampling_options,
+                DownsamplingOption::Off
+            );
+            {
+                config.add_option_change_callback(
+                    graphics::options::ds_option,
+                    [](recomp::config::ConfigValueVariant cur_value, recomp::config::ConfigValueVariant prev_value, OptionChangeContext change_context) {
+                        auto resolution_opt = get_graphics_enum_value<ultramodern::renderer::Resolution>(graphics::options::res_option, change_context);
+                        determine_downsampling_display(resolution_opt, change_context);
+                    }
+                );
+
+                using ultramodern::renderer::Resolution;
+                for (auto resolution : {Resolution::Auto, Resolution::FullHD, Resolution::WQHD, Resolution::UHD}) {
+                    config.add_option_disable_dependency(graphics::options::ds_option, graphics::options::res_option, resolution);
+                }
+    
+                config.on_json_parse_option(graphics::options::ds_option, [](const nlohmann::json& value) {
+                    if (value == 2) {
+                        return uint32_t(DownsamplingOption::X2);
+                    }
+                    if (value == 4) {
+                        return uint32_t(DownsamplingOption::X4);
+                    }
+                    return uint32_t(DownsamplingOption::Off);
+                });
+    
+                config.on_json_serialize_option(graphics::options::ds_option, [](const recomp::config::ConfigValueVariant& value) {
+                    return nlohmann::json(std::get<uint32_t>(value));
+                });
+            }
+
+            config.add_enum_option(
+                graphics::options::rr_option,
+                "Framerate",
+                get_framerate_text(60),
+                refresh_rate_options,
+                ultramodern::renderer::RefreshRate::Original // 40winks default (was Display)
+            );
+
+            config.add_number_option(
+                graphics::options::rr_manual_value,
+                "Target Framerate",
+                get_framerate_text(60),
+                20.0, 240.0, 1.0, 0, false, 60.0
+            );
+            config.update_option_hidden(graphics::options::rr_manual_value, true);
+            auto update_framerate = [](recomp::config::ConfigValueVariant, recomp::config::ConfigValueVariant, OptionChangeContext context) {
+                update_manual_framerate_visibility(context);
+            };
+            config.add_option_change_callback(graphics::options::rr_option, update_framerate);
+            config.add_option_change_callback(graphics::options::advanced_graphics, update_framerate);
+
+            config.add_enum_option(
+                graphics::options::msaa_option,
+                "MS Anti-Aliasing",
+                "Sets the multisample anti-aliasing (MSAA) quality level. This reduces jagged edges in the final image at the expense of rendering performance."
+                "<br />"
+                "<br />"
+                "<recomp-color primary>Note: This option won't be available if your GPU does not support programmable MSAA sample positions, as it is currently required to avoid rendering glitches.</recomp-color>",
+                antialiasing_options,
+                ultramodern::renderer::Antialiasing::None // 40winks default (was MSAA2X)
+            );
+
+            config.add_enum_option(
+                graphics::options::hr_option,
+                "HUD Placement",
+                "Adjusts the placement of HUD elements to fit the selected aspect ratio. <recomp-color primary>Expand</recomp-color> will use the aspect ratio of the game's output window.",
+                hud_ratio_mode_options,
+                ultramodern::renderer::HUDRatioMode::Original // 40winks default (was Clamp16x9)
+            );
+
+            config.add_enum_option(
+                graphics::options::api_option,
+                "Graphics API",
+                "Selects the graphics API to use.",
+                graphics_api_options,
+                ultramodern::renderer::GraphicsApi::Auto,
+                true
+            );
+
+            config.add_enum_option(
+                graphics::options::hpfb_option,
+                "High Precision Framebuffer",
+                "Sets whether to use a high precision framebuffer.",
+                hpfb_options,
+                ultramodern::renderer::HighPrecisionFramebuffer::Off,
+                false // 40winks: shown (was hidden)
+            );
+
+            // 40winks: RT64 settings only reachable from its developer menu. Values are RT64's enum values.
+            config.add_enum_option(
+                graphics::options::tf_option,
+                "Texture Filtering",
+                "<recomp-color primary>3-Point</recomp-color> is the N64's own texture filter. <recomp-color primary>Bilinear</recomp-color> is smoother.",
+                { {1u, "ThreePoint", "3-Point"}, {0u, "Bilinear", "Bilinear"} },
+                1u
+            );
+
+            config.add_enum_option(
+                graphics::options::of_option,
+                "Output Filter",
+                "How the rendered image is scaled to the window. <recomp-color primary>Nearest</recomp-color> keeps sharp pixels, mostly visible at <recomp-color primary>Original</recomp-color> resolution.",
+                { {2u, "PixelScaling", "Pixel Scaling"}, {1u, "Linear", "Linear"}, {0u, "Nearest", "Nearest"} },
+                2u
+            );
+
+            config.add_enum_option(
+                graphics::options::u2d_option,
+                "Upscale 2D",
+                "Which 2D elements (HUD, menus, sprites) are drawn at high resolution. <recomp-color primary>All</recomp-color> is sharper but can show seams between pieces of 2D backgrounds.",
+                { {0u, "Original", "Original"}, {1u, "ScaledOnly", "Scaled Only"}, {2u, "All", "All"} },
+                0u // 40winks default: Original
+            );
+
+            for (const auto &id : {
+                    graphics::options::ds_option, graphics::options::rr_option,
+                    graphics::options::msaa_option,
+                    graphics::options::hr_option, graphics::options::hpfb_option,
+                    graphics::options::tf_option, graphics::options::of_option,
+                    graphics::options::u2d_option }) {
+                config.add_option_hidden_dependency(id, graphics::options::advanced_graphics, false);
+            }
+
+            return config;
+        }
+    }
