+    void create_menus() {
+        recompui::init_styling(recompui::file::get_asset_path("recomp.rcss"));
+        recompui::init_launcher_menu();
+        recompui::init_prompt_context();
+        recompui::AssignPlayersModal::init();
+        recompui::config::init_modal();
