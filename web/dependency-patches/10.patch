-                int *last_mouse_pos = ui_state->last_active_mouse_position;
-
-                if (!ui_state->mouse_is_active) {
-                    float xD = cur_event.motion.x - last_mouse_pos[0];
-                    float yD = cur_event.motion.y - last_mouse_pos[1];
