+void deinit_hook() {
+    recompui::destroy_all_contexts();
+
+    std::lock_guard lock {ui_state_mutex};
+    Rml::Debugger::Shutdown();
+    Rml::Shutdown();
+    ui_state->unload();
+    ui_state.reset();
+}
+
+// Where RT64 replaces a lost device (a page's WebGPU device, a removed D3D12 device, a lost Vulkan device), the menus'
+// render interface makes what it drew with again on the new one, and everything else (RmlUi, the contexts and
+// documents, the menus open) stays as it was.
+void replace_device_hook(plume::RenderInterface* interface, plume::RenderDevice* device) {
+    std::lock_guard lock{ ui_state_mutex };
+    if (ui_state) {
+        ui_state->render_interface.replace_device(interface, device);
+    }
+}
+
+void recompui::set_render_hooks() {
+    RT64::SetRenderHooks(init_hook, draw_hook, deinit_hook);
+    RT64::SetRenderHookReplaceDevice(replace_device_hook);
+}
